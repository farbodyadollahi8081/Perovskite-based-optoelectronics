@article{YANG2003440,
	title = {Stability of anodic aluminum oxide membranes with nanopores},
	journal = {Physics Letters A},
	volume = {318},
	number = {4},
	pages = {440-444},
	year = {2003},
	issn = {0375-9601},
	doi = {https://doi.org/10.1016/j.physleta.2003.09.051},
	url = {https://www.sciencedirect.com/science/article/pii/S037596010301452X},
	author = {S.G. Yang and T. Li and L.S. Huang and T. Tang and J.R. Zhang and B.X. Gu and Y.W. Du and S.Z. Shi and Y.N. Lu},
	keywords = {Anodic aluminum oxide membrane, Nanopore, Stability},
	abstract = {The anodic aluminum oxide membranes (AAOMs) with nanopores, produced by electrochemical etching method in oxalic/sulphuric/phosphoric acid, were transformed from amorphous phase to crystalline phase by annealing. Differential thermal analysis and X-ray diffraction were performed for the phase transformation studies. Scanning electron microscopy studies show that the crystalline AAOMs keep the nanopore morphology and become very stable in the violent acid and violent alkali solutions.}
}

